---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBlock from '../components/ContactBlock.astro';

interface Props {
  title?: string;
  description?: string;
  contact?: boolean; // フッター上のお問い合わせブロック
  noindex?: boolean;
  header?: 'corporate' | 'none';
}
const { title, description = '1963年から、沖縄の厨房と食卓に食材を届けてきた株式会社イバノのコーポレートサイト。業務用食材の卸販売・輸入・店舗・自社商品開発。', contact = true, noindex = false, header = 'corporate' } = Astro.props;
const siteName = '株式会社イバノ';
const fullTitle = title ? `${title}｜${siteName}` : `${siteName}｜沖縄の食を支える`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/ogp.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>
    <slot name="header">{header === 'corporate' && <Header />}</slot>
    <main id="main">
      <slot />
    </main>
    {contact && <ContactBlock />}
    <Footer />
    <script>
      // 画面に入った要素をふわっと出す（prefers-reduced-motion では CSS 側で無効）
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
<style is:global>
  .skip { position: absolute; left: -9999px; top: 0; z-index: 1000; padding: 8px 16px; background: var(--c-ink); color: #fff; }
  .skip:focus { left: 8px; top: 8px; }
</style>
