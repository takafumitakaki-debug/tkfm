---
import Chapter from '../layouts/Chapter.astro';
import Photo from '../components/Photo.astro';
import Text from '../components/Text.astro';
import SectionHead from '../components/SectionHead.astro';
import { single } from '../lib/data';
import { ph } from '../lib/text';
const a = await single('about');
const h = await single('history');
const milestones = h.entries.filter((e) => e.milestone);
---
<Chapter slug="about" nav={[
  { label: '経営理念', href: '#statement' },
  { label: '理念に込めた意味', href: '#meaning' },
  { label: '代表メッセージ', href: '#message' },
  { label: '大切にしていること', href: '#values' },
  { label: '1963年からの歩み', href: '#history' },
]}>
  <!-- 経営理念：1画面を理念だけで使う -->
  <section id="statement" class="st">
    <div class="container">
      <span class="label">Management Philosophy ／ 経営理念</span>
      <Text as="p" class="statement st__text" value={a.statement} />
      {a.statementNote && <Text as="p" class="small" value={a.statementNote} />}
    </div>
  </section>

  <section id="meaning" class="section section--alt">
    <div class="container">
      <SectionHead en="Meaning" title="理念に込めた意味" />
      <div class="mn">
        {a.meanings.map((m) => (
          <article class="mn__item" data-reveal>
            <Photo photo={m.photo} ratio="land" />
            <div class="stack">
              <h3 class="h-lg" set:html={ph(m.keyword)} />
              <Text as="p" value={m.meaning} />
              <p class="small"><strong>現場では ― </strong><span set:html={ph(m.inPractice)} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="message" class="section">
    <div class="container msg">
      <div class="msg__photos">
        {a.message.photos.map((p, i) => <Photo photo={p} ratio={i === 0 ? 'portrait' : 'land'} />)}
      </div>
      <div class="msg__body">
        <span class="label">Message ／ 代表メッセージ</span>
        <h2 class="h-xl" set:html={ph(a.message.heading)} />
        <Text as="div" class="msg__text" value={a.message.body} />
        <p class="msg__sig serif">{a.message.signature}<span class="check">要確認</span></p>
      </div>
    </div>
  </section>

  <section id="values" class="section section--alt">
    <div class="container">
      <SectionHead en="Values" title="会社として大切にしていること" />
      <div class="grid grid--3">
        {a.values.map((v) => (
          <div class="val" data-reveal>
            <h3>{v.target}</h3>
            <Text as="p" value={v.text} />
          </div>
        ))}
      </div>
      <p style="margin-top: var(--sp-7)"><a class="btn" href="/philosophy/">フィロソフィを読む</a></p>
    </div>
  </section>

  <section id="history" class="section">
    <div class="container">
      <SectionHead en="History" title="1963年からの歩み" lead="網羅的な年表ではなく、いまのイバノの形をつくった転機を選んでいます。" />
      <ol class="tl">
        {milestones.map((e) => (
          <li class="tl__item" data-reveal>
            <p class="tl__year">{e.year}{e.month && <small>.{e.month}</small>}</p>
            <div class="tl__body stack">
              <h3 class="h-lg"><span set:html={ph(e.title)} />{!e.confirmed && <span class="check">要確認</span>}</h3>
              {e.story && <Text as="p" value={e.story} />}
            </div>
            <Photo photo={e.photo} ratio="land" />
          </li>
        ))}
      </ol>
      <a class="btn" href="/company/#history">詳しい沿革</a>
    </div>
  </section>
</Chapter>
<style>
  .st { display: grid; align-items: center; min-height: 80svh; padding-block: var(--sp-9); text-align: center; }
  .st__text { margin: var(--sp-6) auto; max-width: 22em; }
  .mn { display: grid; gap: var(--sp-8); }
  .mn__item { display: grid; gap: var(--sp-6); align-items: center; }
  @media (min-width: 960px) { .mn__item { grid-template-columns: 1fr 1fr; } .mn__item:nth-child(even) > :first-child { order: 2; } }
  .msg { display: grid; gap: var(--sp-7); }
  @media (min-width: 960px) { .msg { grid-template-columns: 5fr 7fr; } .msg__photos { position: sticky; top: calc(var(--header-h) + var(--sp-5)); align-self: start; } }
  .msg__photos { display: grid; gap: var(--sp-4); }
  .msg__body .h-xl { margin: var(--sp-3) 0 var(--sp-6); }
  .msg__text { max-width: var(--w-text); }
  .msg__sig { margin-top: var(--sp-6); text-align: right; font-size: var(--fs-md); }
  .val { padding-top: var(--sp-5); border-top: 2px solid var(--c-ink); }
  .val h3 { font-size: var(--fs-md); margin-bottom: var(--sp-3); }
  .tl { list-style: none; padding: 0; margin: 0 0 var(--sp-7); border-left: 1px solid var(--c-line); }
  .tl__item { position: relative; display: grid; gap: var(--sp-4); padding: 0 0 var(--sp-8) var(--sp-6); }
  .tl__item::before { content: ""; position: absolute; left: -5px; top: .9em; width: 9px; height: 9px; border-radius: 50%; background: var(--c-accent); }
  @media (min-width: 960px) { .tl__item { grid-template-columns: 9em 1fr 320px; gap: var(--sp-6); } }
  .tl__year { margin: 0; font-family: var(--ff-serif); font-size: var(--fs-xl); line-height: 1.3; color: var(--c-accent); }
  .tl__year small { font-size: var(--fs-sm); }
</style>
