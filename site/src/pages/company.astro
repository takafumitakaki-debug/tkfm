---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InPageNav from '../components/InPageNav.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import Fact from '../components/Fact.astro';
import Text from '../components/Text.astro';
import { single } from '../lib/data';
import { ph } from '../lib/text';
const co = await single('company');
const h = await single('history');
const about = await single('about');
const kindLabel = { hq: '本社', warehouse: '倉庫・物流', shop: '店舗' } as const;
const outline: [string, any][] = [
  ['会社名', { value: co.name, confirmed: true }],
  ['創業', co.founded], ['設立', co.established], ['代表者', co.representative], ['資本金', co.capital],
  ['従業員数', co.employees], ['本社所在地', { value: `〒${co.postal.value} ${co.address.value}`, confirmed: co.postal.confirmed && co.address.confirmed }],
  ['事業内容', co.business], ['主要取引先', co.clients], ['取引銀行', co.banks],
];
---
<Base title="会社情報" description="株式会社イバノの会社概要・代表者・沿革・拠点・アクセス。">
  <PageHero en="Company" title="会社情報" />
  <div class="container" style="padding-top: var(--sp-7)"><Photo photo={co.hero} ratio="pano" eager /></div>
  <InPageNav items={[
    { label: '会社概要', href: '#outline' }, { label: '代表者', href: '#message' }, { label: '沿革', href: '#history' },
    { label: '拠点・アクセス', href: '#access' }, { label: '認定・加盟団体', href: '#certification' },
  ]} />

  <section id="outline" class="section">
    <div class="container container--text">
      <SectionHead en="Outline" title="会社概要" />
      <table class="table">
        {outline.map(([k, v]) => <tr><th>{k}</th><td><Fact fact={v} /></td></tr>)}
      </table>
    </div>
  </section>

  <section id="message" class="section section--alt">
    <div class="container rep">
      <Photo photo={about.message.photos[0]} ratio="portrait" />
      <div class="stack">
        <SectionHead en="Representative" title="代表者" />
        <p class="serif h-lg"><Fact fact={co.representative} /></p>
        <Text as="p" value={about.message.excerpt} />
        <a class="textlink" href="/about/#message">代表メッセージ全文</a>
      </div>
    </div>
  </section>

  <section id="history" class="section">
    <div class="container container--text">
      <SectionHead en="History" title="沿革" />
      <table class="table hist">
        {h.entries.map((e) => (
          <tr>
            <th>{e.year}{e.month && `年${e.month}月`}</th>
            <td><span set:html={ph(e.title)} />{!e.confirmed && <span class="check">要確認</span>}</td>
          </tr>
        ))}
      </table>
    </div>
  </section>

  <section id="access" class="section section--alt">
    <div class="container">
      <SectionHead en="Access" title="拠点・アクセス" />
      <div class="grid grid--2">
        {co.locations.map((l) => (
          <article class="loc" data-reveal>
            <Photo photo={l.photo} ratio="land" />
            <span class="tag">{kindLabel[l.kind]}</span>
            <h3 class="h-lg"><span set:html={ph(l.name)} />{!l.confirmed && <span class="check">要確認</span>}</h3>
            <table class="table">
              <tr><th>住所</th><td set:html={ph(l.address)} /></tr>
              {l.tel && <tr><th>電話</th><td set:html={ph(l.tel)} /></tr>}
              {l.hours && <tr><th>営業時間</th><td set:html={ph(l.hours)} /></tr>}
              {l.parking && <tr><th>駐車場</th><td set:html={ph(l.parking)} /></tr>}
            </table>
            {l.mapUrl ? <a class="textlink" href={l.mapUrl} target="_blank" rel="noopener">Googleマップで見る</a> : <span class="ph">【地図（Googleマップ）を配置】</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="certification" class="section">
    <div class="container container--text">
      <SectionHead en="Certification" title="認定・加盟団体" />
      <ul class="cert">
        {co.certifications.map((c) => <li><strong set:html={ph(c.name)} />{c.detail && <span class="small">（{c.detail}）</span>}{!c.confirmed && <span class="check">要確認</span>}</li>)}
      </ul>
      <p style="margin-top: var(--sp-8)"><a class="btn" href="/about/">イバノが大切にしていること</a></p>
    </div>
  </section>
</Base>
<style>
  .rep { display: grid; gap: var(--sp-7); align-items: center; }
  @media (min-width: 960px) { .rep { grid-template-columns: 4fr 8fr; } }
  .hist th { width: 8em; font-family: var(--ff-serif); color: var(--c-accent); }
  .loc { display: grid; gap: var(--sp-3); justify-items: start; }
  .loc .table { margin-block: var(--sp-2); }
  .cert { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--c-ink); }
  .cert li { padding: var(--sp-4) 0; border-bottom: 1px solid var(--c-line); }
</style>
