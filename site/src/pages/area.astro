---
import Chapter from '../layouts/Chapter.astro';
import Photo from '../components/Photo.astro';
import Text from '../components/Text.astro';
import SectionHead from '../components/SectionHead.astro';
import ChapterChain from '../components/ChapterChain.astro';
import NewsList from '../components/NewsList.astro';
import { single, news } from '../lib/data';
const a = await single('area');
const about = await single('about');
const areaNews = (await news()).filter((n) => n.data.category === 'area').slice(0, 3);
---
<Chapter slug="area" nav={[
  { label: 'ここまでの章', href: '#recap' },
  ...a.axes.map((x) => ({ label: x.title, href: `#${x.key}` })),
  { label: 'これから目指すこと', href: '#future' },
]}>
  <section id="recap" class="section">
    <div class="container">
      <SectionHead en="Recap" title="01〜04 の先に、地域がある。" />
      <Text as="p" class="lead container--text" value={a.lead} />
      <div style="margin-top: var(--sp-7)"><ChapterChain current="area" /></div>
    </div>
  </section>

  {a.axes.map((x, i) => (
    <section id={x.key} class:list={['section', { 'section--alt': i % 2 === 0 }]}>
      <div class="container ax">
        <Photo photo={x.photo} ratio="land" />
        <div class="stack">
          <span class="ax__n">0{i + 1}</span>
          <h2 class="h-xl">{x.title}</h2>
          <Text as="p" value={x.body} />
          {x.examples.length > 0 && <ul class="ax__ex">{x.examples.map((e) => <Text as="li" value={e} />)}</ul>}
          {x.key === 'community' && areaNews.length > 0 && <NewsList items={areaNews} />}
          {x.cta && <p><a class="btn" href={x.cta.href}>{x.cta.label}</a></p>}
        </div>
      </div>
    </section>
  ))}

  <section id="future" class="section">
    <div class="container grid grid--2" style="align-items: center">
      <div class="stack">
        <SectionHead en="Next" title="これから目指すこと" />
        <Text as="p" value={a.future} />
      </div>
      <Photo photo={a.futurePhoto} ratio="land" />
    </div>
  </section>

  <section class="section section--deep cl">
    <div class="container">
      <p class="cl__copy serif">{a.closing}</p>
      <Text as="p" class="cl__statement serif" value={about.statement} />
    </div>
    <div class="cl__photo"><Photo photo={a.closingPhoto} ratio="pano" /></div>
  </section>

  <nav slot="end" class="fork" aria-label="次の行動">
    <div class="container grid grid--2">
      <a href="/recruit/" class="fork__item"><span class="label">Join us</span><strong>一緒に働く</strong><span>採用情報</span></a>
      <a href="/contact/?type=business" class="fork__item fork__item--accent"><span class="label">Work with us</span><strong>一緒に仕事をする</strong><span>お取引のご相談</span></a>
    </div>
  </nav>
</Chapter>
<style>
  .ax { display: grid; gap: var(--sp-7); align-items: center; }
  @media (min-width: 960px) { .ax { grid-template-columns: 1fr 1fr; } }
  .ax__n { font-family: var(--ff-serif); font-size: var(--fs-2xl); color: var(--c-accent); line-height: 1; }
  .ax__ex { font-size: var(--fs-sm); color: var(--c-ink-2); }
  .cl { text-align: center; padding-bottom: 0; }
  .cl__copy { font-size: var(--fs-2xl); letter-spacing: .25em; }
  .cl__statement { margin: var(--sp-6) auto var(--sp-8); max-width: 30em; color: var(--c-on-deep-2); }
  .cl__photo { padding-inline: var(--gutter); max-width: 1440px; margin-inline: auto; }
  .fork { background: var(--c-deep); padding-block: var(--sp-8); }
  .fork__item { display: grid; gap: var(--sp-2); padding: var(--sp-7) var(--sp-6); border: 1px solid rgba(255,255,255,.3); color: var(--c-on-deep); text-decoration: none; transition: background var(--dur) var(--ease); }
  .fork__item .label { color: var(--c-on-deep-2); }
  .fork__item strong { font-family: var(--ff-serif); font-size: var(--fs-xl); letter-spacing: .15em; }
  .fork__item:hover { background: rgba(255,255,255,.06); color: #fff; }
  .fork__item--accent { background: var(--c-accent); border-color: var(--c-accent); }
  .fork__item--accent:hover { background: var(--c-accent-hover); }
</style>
