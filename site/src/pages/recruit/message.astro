---
import Recruit from '../../layouts/Recruit.astro';
import PageHero from '../../components/PageHero.astro';
import Text from '../../components/Text.astro';
import SectionHead from '../../components/SectionHead.astro';
import { single } from '../../lib/data';
import { ph } from '../../lib/text';
const r = await single('recruit');
const about = await single('about');
const philo = await single('philosophy');
---
<Recruit title="イバノで働く意味">
  <PageHero en="Message" title="イバノで働く意味" />
  <section class="section">
    <div class="container container--text stack">
      <Text as="p" class="statement" value={r.message} />
      <Text as="p" class="lead" value={r.meaning} />
    </div>
  </section>
  <section class="section section--alt">
    <div class="container container--text stack">
      <SectionHead en="From the President" title="代表から、これから仲間になる人へ" />
      <Text as="p" value={r.ceoMessage} />
      <p class="serif" style="text-align: right">{about.message.signature}<span class="check">要確認</span></p>
    </div>
  </section>
  <section class="section">
    <div class="container container--text">
      <SectionHead en="Philosophy" title="経営理念とフィロソフィ" />
      <Text as="p" class="statement" value={about.statement} />
      <ol class="pl">
        {philo.items.map((it, i) => (
          <li><span class="pl__n">02-{i + 1}</span><strong set:html={ph(it.title)} /><span class="small">新人の仕事では ― <span class="ph">【この考え方が新人の仕事でどう現れるかを配置】</span></span></li>
        ))}
      </ol>
      <p><a class="textlink" href="/philosophy/">フィロソフィの全文（コーポレートサイト）</a></p>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container container--text stack">
      <SectionHead en="Who we want" title="求める人物像" />
      <Text as="p" value={r.persona} />
    </div>
  </section>
</Recruit>
<style>
  .statement { font-size: var(--fs-xl); }
  .pl { list-style: none; padding: 0; margin: var(--sp-7) 0; border-top: 1px solid var(--c-ink); }
  .pl li { display: grid; grid-template-columns: 4em 1fr; gap: var(--sp-1) var(--sp-4); padding: var(--sp-4) 0; border-bottom: 1px solid var(--c-line); }
  .pl__n { grid-row: span 2; font-family: var(--ff-serif); color: var(--c-accent); }
</style>
