---
// グローバルナビ：左＝章（01〜05）／中＝情報／右＝行動（docs/01_sitemap.md §2）
import { chapters } from '../lib/data';
const list = await chapters();
const path = Astro.url.pathname;
const isCur = (href: string) => path.startsWith(href);
const util = [
  { label: 'ニュース', href: '/news/' },
  { label: '会社情報', href: '/company/' },
  { label: '店舗情報', href: '/business/shop/' },
];
---
<header class="hd">
  <div class="hd__in">
    <a href="/" class="hd__logo" aria-label="株式会社イバノ トップページ">
      <span class="hd__mark">IVANO</span><span class="hd__name">株式会社イバノ</span>
    </a>
    <nav class="hd__nav" aria-label="グローバルナビゲーション">
      <ul class="hd__chapters">
        {list.map((c) => (
          <li><a href={`/${c.slug}/`} aria-current={isCur(`/${c.slug}/`) ? 'page' : undefined}><span class="n">{c.num}</span>{c.title}</a></li>
        ))}
      </ul>
      <ul class="hd__util">
        {util.map((u) => <li><a href={u.href} aria-current={isCur(u.href) ? 'page' : undefined}>{u.label}</a></li>)}
      </ul>
      <div class="hd__act">
        <a class="hd__btn" href="/recruit/">採用情報</a>
        <a class="hd__btn hd__btn--fill" href="/contact/">お問い合わせ</a>
      </div>
    </nav>
    <a class="hd__mcontact" href="/contact/" aria-label="お問い合わせ">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg>
    </a>
    <button class="hd__menu" type="button" aria-expanded="false" aria-controls="sp-menu">
      <span class="hd__bars" aria-hidden="true"></span><span class="hd__menu-label">MENU</span>
    </button>
  </div>

  <div id="sp-menu" class="sp" hidden>
    <ul class="sp__chapters">
      {list.map((c) => (
        <li><a href={`/${c.slug}/`}><span class="n">{c.num}</span><span class="t">{c.title}</span><span class="e">{c.en}</span></a></li>
      ))}
    </ul>
    <ul class="sp__util">
      <li><a href="/">トップ</a></li>
      {util.map((u) => <li><a href={u.href}>{u.label}</a></li>)}
    </ul>
    <div class="sp__act">
      <a class="btn" href="/recruit/">採用情報</a>
      <a class="btn btn--primary" href="/contact/">お問い合わせ</a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hd__menu');
  const menu = document.getElementById('sp-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
    document.documentElement.classList.toggle('is-menu-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') btn.click();
  });
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 100; background: color-mix(in srgb, var(--c-paper) 94%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--c-line); }
  .hd__in { display: flex; align-items: center; gap: var(--sp-5); height: var(--header-h); padding-inline: var(--gutter); max-width: 1440px; margin-inline: auto; }
  .hd__logo { display: flex; align-items: baseline; gap: .8em; text-decoration: none; flex-shrink: 0; }
  .hd__mark { font-family: var(--ff-serif); font-size: 1.375rem; font-weight: 600; letter-spacing: .28em; }
  .hd__name { font-size: var(--fs-xs); color: var(--c-ink-2); letter-spacing: .1em; }
  .hd__nav { display: flex; align-items: center; gap: var(--sp-5); margin-left: auto; }
  .hd ul { list-style: none; margin: 0; padding: 0; display: flex; }
  .hd__chapters { gap: var(--sp-4); }
  .hd__chapters a { display: block; padding: var(--sp-2) 0; font-size: var(--fs-sm); text-decoration: none; letter-spacing: .12em; border-bottom: 1px solid transparent; }
  .hd__chapters .n { font-family: var(--ff-serif); color: var(--c-accent); margin-right: .35em; font-size: var(--fs-xs); }
  .hd a[aria-current="page"] { border-bottom-color: var(--c-accent); }
  .hd .hd__util { gap: var(--sp-4); padding-left: var(--sp-5); border-left: 1px solid var(--c-line); }
  .hd__util a { font-size: var(--fs-xs); color: var(--c-ink-2); text-decoration: none; padding: var(--sp-2) 0; border-bottom: 1px solid transparent; }
  .hd__act { display: flex; gap: var(--sp-2); }
  .hd__btn { display: inline-flex; align-items: center; height: 40px; padding: 0 1.1em; border: 1px solid var(--c-ink); border-radius: var(--radius); font-size: var(--fs-xs); font-weight: 500; letter-spacing: .1em; text-decoration: none; }
  .hd__btn:hover { background: var(--c-ink); color: var(--c-paper); }
  .hd__btn--fill { background: var(--c-accent); border-color: var(--c-accent); color: #fff; }
  .hd__btn--fill:hover { background: var(--c-accent-hover); border-color: var(--c-accent-hover); color: #fff; }
  .hd__mcontact, .hd__menu { display: none; }

  @media (max-width: 1199px) { .hd__name { display: none; } .hd__util { display: none; } }
  @media (max-width: 959px) {
    .hd__nav { display: none; }
    .hd__mcontact { display: grid; place-items: center; width: 44px; height: 44px; margin-left: auto; color: var(--c-ink); }
    .hd__menu { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 48px; height: 48px; justify-content: center; border: 0; background: none; color: var(--c-ink); cursor: pointer; }
    .hd__menu-label { font-size: 9px; letter-spacing: .15em; }
    .hd__bars, .hd__bars::before, .hd__bars::after { display: block; width: 22px; height: 1.5px; background: currentColor; transition: transform var(--dur) var(--ease); }
    .hd__bars { position: relative; }
    .hd__bars::before, .hd__bars::after { content: ""; position: absolute; left: 0; }
    .hd__bars::before { top: -6px; } .hd__bars::after { top: 6px; }
    .hd__menu[aria-expanded="true"] .hd__bars { background: transparent; }
    .hd__menu[aria-expanded="true"] .hd__bars::before { transform: translateY(6px) rotate(45deg); }
    .hd__menu[aria-expanded="true"] .hd__bars::after { transform: translateY(-6px) rotate(-45deg); }
  }
  .sp { position: fixed; inset: var(--header-h) 0 0; overflow-y: auto; background: var(--c-paper); padding: var(--sp-5) var(--gutter) var(--sp-8); }
  .sp[hidden] { display: none; }
  .sp ul { flex-direction: column; }
  .sp__chapters a { display: grid; grid-template-columns: 3.2em 1fr auto; align-items: baseline; padding: var(--sp-4) 0; border-bottom: 1px solid var(--c-line); text-decoration: none; }
  .sp__chapters .n { font-family: var(--ff-serif); font-size: var(--fs-lg); color: var(--c-accent); }
  .sp__chapters .t { font-family: var(--ff-serif); font-size: var(--fs-lg); font-weight: 600; letter-spacing: .15em; }
  .sp__chapters .e { font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-ink-3); }
  .sp__util { margin-top: var(--sp-5) !important; display: grid !important; grid-template-columns: 1fr 1fr; gap: var(--sp-3) var(--sp-5); }
  .sp__util a { font-size: var(--fs-sm); text-decoration: none; }
  .sp__act { display: grid; gap: var(--sp-3); margin-top: var(--sp-6); }
  :global(.is-menu-open) body { overflow: hidden; }
</style>
